# 1. Usa una imagen oficial de Python como base. 'slim' es una versión ligera.
FROM python:3.11-slim

# 2. Establece el directorio de trabajo dentro del contenedor.
WORKDIR /app

# 3. Copia solo el archivo de requerimientos primero.
#    Esto aprovecha el sistema de caché de Docker. Si requirements.txt no cambia,
#    Docker no volverá a instalar las dependencias, haciendo las construcciones futuras más rápidas.
COPY requirements.txt .

# 4. Instala las dependencias de Python.
#    --no-cache-dir reduce el tamaño final de la imagen.
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copia pyproject.toml para la configuración del paquete
COPY pyproject.toml .

# 5. Copia el directorio src con todos los módulos necesarios
COPY ./src /app/src

# 6. Copia alembic.ini para migraciones
COPY alembic.ini .

# 7. Configurar PYTHONPATH para que Gunicorn encuentre los módulos
ENV PYTHONPATH=/app/src

# 8. Comando por defecto para ejecutar la API
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "geostab_api.main:app", "--bind", "0.0.0.0:8000"]
