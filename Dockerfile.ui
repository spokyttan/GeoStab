# Dockerfile.ui - GeoStab Streamlit Frontend

# 1. Usa una imagen oficial de Python como base. 'slim' es una versión ligera.
FROM python:3.9-slim

# 2. Establece el directorio de trabajo dentro del contenedor.
WORKDIR /app

# 3. Copia solo el archivo de requerimientos primero para aprovechar el caché de Docker.
COPY requirements.txt .

# 4. Instala las dependencias de Python.
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copia pyproject.toml para la configuración del paquete
COPY pyproject.toml .

# 6. Copia el directorio src con todos los módulos necesarios
COPY ./src /app/src

# 7. Copia el código fuente de la aplicación de Streamlit.
COPY streamlit_app.py .

# 8. Expone el puerto en el que Streamlit se ejecutará.
EXPOSE 8501

# El comando para ejecutar la app ya está en tu docker-compose.yml