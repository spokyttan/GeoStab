# Use Nginx Alpine for serving static content
FROM nginx:alpine

# Copy custom Nginx config to listen on 8501
COPY nginx_ui.conf /etc/nginx/conf.d/default.conf

# Copy static assets to Nginx root
COPY public /usr/share/nginx/html

# Expose port 8501
EXPOSE 8501

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]